# Copy this to apps/server/.env and fill in .env, NOT this file (this file is committed to git).
# Real values go only in .env, never in chat.

# Create a key at openrouter.ai → Keys (set a credit limit on it)
OPENROUTER_API_KEY=

# Exact model id from openrouter.ai/models: a fast, NON-reasoning model with JSON output.
# Tested and recommended: openai/gpt-4.1-nano
OPENROUTER_MODEL=

PORT=3000
