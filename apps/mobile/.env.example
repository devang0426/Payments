# Copy this to apps/mobile/.env.
# EXPO_PUBLIC_* values are bundled into the app, so NO keys or secrets here.

# Development: your laptop's Wi-Fi IP (Windows: ipconfig, Mac: ipconfig getifaddr en0)
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# For the demo APK, use the Vercel HTTPS URL:
# EXPO_PUBLIC_API_URL=https://your-project.vercel.app
